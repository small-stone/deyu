.ring-wrap {
  width: 216rpx;
  height: 216rpx;
  flex-shrink: 0;
}

.ring-outer {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 16rpx solid rgba(255, 255, 255, 0.85);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.12);
}

.ring-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.n {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
  color: #fff;
}

.u {
  font-size: 22rpx;
  opacity: 0.85;
  color: #fff;
  margin-top: 4rpx;
}
