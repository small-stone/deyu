.ring-wrap {
  width: 216rpx;
  height: 216rpx;
  position: relative;
  flex-shrink: 0;
}

.ring-track,
.ring-progress {
  position: absolute;
  inset: 0;
  border-radius: 50%;
}

.ring-track {
  background: rgba(255, 255, 255, 0.18);
}

.ring-progress {
  mask: radial-gradient(transparent 62%, #000 63%);
  -webkit-mask: radial-gradient(transparent 62%, #000 63%);
}

.center {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.n {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
  color: #fff;
}

.u {
  font-size: 22rpx;
  opacity: 0.85;
  color: #fff;
  margin-top: 4rpx;
}
