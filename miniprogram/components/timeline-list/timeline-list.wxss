.timeline {
  position: relative;
  padding-left: 8rpx;
}

.tl-item {
  display: flex;
  gap: 20rpx;
  padding: 16rpx 0;
  position: relative;
}

.tl-dot {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.tl-dot.up {
  background: #DDF4EE;
  color: #0A6B5C;
}

.tl-dot.down {
  background: #FCEBE6;
  color: #E07A5F;
}

.tl-body {
  flex: 1;
  background: #fff;
  border: 1rpx solid rgba(14, 143, 122, 0.12);
  border-radius: 24rpx;
  padding: 18rpx 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(14, 143, 122, 0.06);
}

.reason {
  font-size: 28rpx;
  font-weight: 600;
  color: #1B2E2A;
}

.when {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(27, 46, 42, 0.45);
}
