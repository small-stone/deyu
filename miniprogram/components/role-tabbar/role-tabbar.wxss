.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid rgba(14, 143, 122, 0.12);
  padding: 12rpx 8rpx calc(12rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 32rpx rgba(14, 143, 122, 0.06);
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: rgba(27, 46, 42, 0.45);
  font-weight: 600;
  padding: 16rpx 0;
}

.tab.on {
  color: #0A6B5C;
}
