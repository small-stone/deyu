<view class="tabbar">
  <block wx:if="{{role === 'parent'}}">
    <view class="tab {{active === 'home' ? 'on' : ''}}" data-key="home" bindtap="onTap">孩子</view>
    <view class="tab {{active === 'bind' ? 'on' : ''}}" data-key="bind" bindtap="onTap">绑定</view>
    <view class="tab {{active === 'profile' ? 'on' : ''}}" data-key="profile" bindtap="onTap">我的</view>
  </block>
  <block wx:elif="{{role === 'teacher'}}">
    <view class="tab {{active === 'home' ? 'on' : ''}}" data-key="home" bindtap="onTap">本班</view>
    <view class="tab {{active === 'students' ? 'on' : ''}}" data-key="students" bindtap="onTap">学生</view>
    <view class="tab {{active === 'board' ? 'on' : ''}}" data-key="board" bindtap="onTap">看板</view>
    <view class="tab {{active === 'profile' ? 'on' : ''}}" data-key="profile" bindtap="onTap">我的</view>
  </block>
  <block wx:else>
    <view class="tab {{active === 'overview' ? 'on' : ''}}" data-key="overview" bindtap="onTap">总览</view>
    <view class="tab {{active === 'rank' ? 'on' : ''}}" data-key="rank" bindtap="onTap">排名</view>
    <view class="tab {{active === 'classes' ? 'on' : ''}}" data-key="classes" bindtap="onTap">班级</view>
    <view class="tab {{active === 'profile' ? 'on' : ''}}" data-key="profile" bindtap="onTap">设置</view>
  </block>
</view>
