.stat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.stat {
  width: calc(50% - 8rpx);
  background: #fff;
  border: 1rpx solid rgba(14, 143, 122, 0.12);
  border-radius: 28rpx;
  padding: 22rpx;
  box-sizing: border-box;
}

.stat .k {
  font-size: 22rpx;
  color: rgba(27, 46, 42, 0.45);
  font-weight: 600;
}

.stat .v {
  font-size: 40rpx;
  font-weight: 700;
  margin-top: 8rpx;
  color: #1B2E2A;
  letter-spacing: -1rpx;
}

.stat .v.hi,
.stat.hi .v {
  color: #0E8F7A;
}

.stat .v.lo,
.stat.lo .v {
  color: #E07A5F;
}

.stat .s {
  font-size: 22rpx;
  color: rgba(27, 46, 42, 0.45);
  margin-top: 4rpx;
}
