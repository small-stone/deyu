<view class="shell">
  <view class="body">
    <view hidden="{{tab !== 'overview'}}" wx:if="{{visited.overview}}">
      <admin-overview active="{{tab === 'overview'}}" bind:switchtab="onSwitchTab" />
    </view>
    <view hidden="{{tab !== 'rank'}}" wx:if="{{visited.rank}}">
      <admin-rank active="{{tab === 'rank'}}" />
    </view>
    <view hidden="{{tab !== 'classes'}}" wx:if="{{visited.classes}}">
      <admin-classes active="{{tab === 'classes'}}" />
    </view>
    <view hidden="{{tab !== 'profile'}}" wx:if="{{visited.profile}}">
      <app-profile active="{{tab === 'profile'}}" role="admin" />
    </view>
  </view>
  <role-tabbar role="admin" active="{{tab}}" bind:change="onTabChange" />
</view>
