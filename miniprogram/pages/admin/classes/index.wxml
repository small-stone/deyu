<view class="page">
  <view class="nav-row">
    <view>
      <view class="nav-title">班级列表</view>
      <view class="sub">点击查看班级看板</view>
    </view>
  </view>

  <view class="card pad">
    <student-row
      wx:for="{{classes}}"
      wx:key="id"
      name="{{item.name}}"
      avatar="{{item.name}}"
      meta="{{item.teacherName}} · 均分 {{item.avg}}"
      showHl="{{true}}"
      high="{{item.high}}"
      low="{{item.low}}"
      data-id="{{item.id}}"
      bind:tap="openClass"
    />
  </view>

  <role-tabbar role="admin" active="classes" />
</view>
