.head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 8rpx;
}

.mid {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 32rpx;
  font-weight: 700;
}

.meta-t {
  font-size: 22rpx;
  color: rgba(27, 46, 42, 0.45);
  margin-top: 4rpx;
}

.score-big {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--brand);
}

.score-big.lo {
  color: var(--coral);
}

.empty {
  padding: 48rpx 32rpx;
  color: rgba(27, 46, 42, 0.55);
  text-align: center;
}
