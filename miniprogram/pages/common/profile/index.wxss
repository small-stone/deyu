.card .row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(14, 143, 122, 0.08);
}

.card .row:last-child {
  border-bottom: none;
}

.name {
  font-size: 30rpx;
  font-weight: 700;
}

.meta-t {
  font-size: 22rpx;
  color: rgba(27, 46, 42, 0.45);
  margin-top: 6rpx;
}

.arrow {
  color: rgba(27, 46, 42, 0.35);
  font-size: 36rpx;
}
